{
  "$schema": "https://opencode.ai/config.json",
  "model": "kai-litellm-dev/kai-dev-code",
  "small_model": "kai-litellm-dev/kai-dev-economy",
  "provider": {
    "kai-litellm-dev": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KAI Entwicklerreserve (LiteLLM-Dev-Proxy durch SSH-Tunnel, ADR 0020)",
      "options": {
        "baseURL": "http://127.0.0.1:4001/v1",
        "apiKey": "{env:KAI_DEV_LITELLM_KEY}"
      },
      "models": {
        "kai-dev-economy": { "name": "kai-dev-economy - Analyse, Tests, kleine Fixes" },
        "kai-dev-code": { "name": "kai-dev-code - regulaere Coding-Reserve" },
        "kai-dev-frontier": { "name": "kai-dev-frontier - nur nach Freigabe je Aufgabe" }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.macaroon": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*wallet*": "deny",
      "*secrets*": "deny"
    },
    "edit": "ask",
    "webfetch": "ask",
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "python -m pytest*": "allow",
      "python -m ruff*": "allow",
      "ruff *": "allow",
      "git push*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "gh pr merge*": "deny",
      "gh pr create*": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      "sudo *": "deny",
      "systemctl *": "deny"
    }
  }
}
