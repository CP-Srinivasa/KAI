# Eingeschraenktes sudo fuer Deploy + Service-Watchdog (ersetzt NOPASSWD:ALL).
#
# Installation (als root):
#   sudo install -m 0440 -o root -g root deploy/sudoers.d/kai-deploy /etc/sudoers.d/kai-deploy
#   sudo visudo -c        # Syntax pruefen, BEVOR die breite Regel entfernt wird
#
# Warum: `ubuntu ALL=(ALL) NOPASSWD:ALL` gab JEDEM der 59 als `ubuntu` laufenden
# KAI-Dienste einen passwortfreien Weg nach root. Ein kompromittierter Dienst
# (Ingest-Pfad, Python-Abhaengigkeit, Telegram-Bot) war damit sofort root — aus
# "ein Dienst kaputt" wurde "der ganze Host". Diese Datei laesst genau die
# Kommandos passwortfrei, die der automatisierte Betrieb braucht.
#
# Was NICHT hier steht, und warum:
#   * `bash scripts/pi_install_systemd.sh` — das Skript gehoert `ubuntu` und ist
#     von `ubuntu` beschreibbar. NOPASSWD darauf waere exakt so viel wert wie
#     NOPASSWD:ALL. Unit-Installation ist selten genug, um sie mit Passwort zu
#     fahren.
#   * `apt-get`, `install`, `ln -s`, Datei-Kopien nach /etc — bewusste, seltene
#     Eingriffe.
#   * `daemon-reload` — braucht nur, wer Unit-Dateien aendert; das ist derselbe
#     seltene, passwortpflichtige Vorgang.
#
# Warum die `kai-*`-Wildcard sicher ist (geprueft 2026-08-18): von 61 kai-Units
# laufen genau zwei ohne `User=` und damit als root — kai-standby-data und
# kai-standby-system. Beide fuehren /usr/local/bin/standby_to_usb.sh aus, das
# root:root 0755 gehoert und fuer `ubuntu` NICHT beschreibbar ist. Es gibt damit
# keine kai-Unit, ueber die `ubuntu` eigenen Code als root ausfuehren koennte.
# Diese Annahme haelt der Repo-Test test_systemd_units_run_unprivileged.py fest —
# wer eine root-Unit mit beschreibbarem ExecStart ergaenzt, bricht ihn.

Cmnd_Alias KAI_SERVICE_CTL = /usr/bin/systemctl start kai-*, \
                             /usr/bin/systemctl stop kai-*, \
                             /usr/bin/systemctl restart kai-*, \
                             /usr/bin/systemctl reload kai-*

ubuntu ALL=(root) NOPASSWD: KAI_SERVICE_CTL
