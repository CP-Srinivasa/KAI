# Install as /etc/kai/litellm.env, owner root:ubuntu, mode 0640.
# Never place literal credentials in the systemd unit or repository.
LITELLM_MASTER_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional future providers remain inactive until both a config entry and key
# are explicitly reviewed and installed.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
