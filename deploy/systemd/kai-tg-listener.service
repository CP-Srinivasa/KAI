[Unit]
Description=KAI Telegram Premium-Channel MTProto Listener
After=network-online.target
Wants=network-online.target
# F2-P3 (2026-05-06, fixed-section 2026-05-11): hard cap restart storms.
# RestartSec=30 makes 5 restarts physically take ≥150s, so the
# default StartLimitBurst=5 / StartLimitIntervalSec=10 was already
# unreachable — but explicit windows kill the service after 10
# restarts in 5 min instead of letting it churn silently.
# NOTE: These keys MUST live in [Unit], not [Service]. systemd silently
# ignores them in [Service] with "Unknown key" warnings (NB1, 2026-05-11).
StartLimitIntervalSec=300
StartLimitBurst=10
OnFailure=kai-unit-failure-notify@%n.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# Der Code liegt im unveraenderlichen Release; `current` wird vom Wrapper
# beim Start AUFGELOEST und der aufgeloeste Pfad im Marker gefuehrt — ein
# spaeter umgeschaltetes current etikettiert diesen Prozess nicht um.
WorkingDirectory=/home/kai/current
# Kein __pycache__ im versiegelten Baum — sonst versuchte der Interpreter,
# genau das zu beschreiben, was unveraenderlich sein soll.
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/home/kai/ai_analyst_trading_bot/.env
Environment=PYTHONIOENCODING=utf-8
# D-208: ensure logs/ exists and is owned by service-user before systemd
# opens StandardOutput=append: as root.
ExecStartPre=+/bin/bash -c 'mkdir -p /home/kai/ai_analyst_trading_bot/logs && chown -R ubuntu:ubuntu /home/kai/ai_analyst_trading_bot/logs'
# Selbst-Attestierung: dieser Prozess ermittelt seine Revision, schreibt den
# Marker unter der EIGENEN PID und wird dann per os.execv zum Dienst. execv
# behaelt PID und Kernel-Startzeit, also sind Marker und Dienst dieselbe
# Identitaet. ExecStartPost koennte das nicht: ein zweiter Prozess wuerde
# einen selbst gelesenen Commit einer fremden MainPID zuschreiben.
ExecStart=/home/kai/current/.venv/bin/python -m app.cli.main trading runtime-exec --unit %n --repo /home/kai/current -- /home/kai/current/.venv/bin/python -m app.cli.main ingestion telegram-channel run
Restart=always
RestartSec=30
StandardOutput=append:/home/kai/ai_analyst_trading_bot/logs/telegram_listener.log
StandardError=append:/home/kai/ai_analyst_trading_bot/logs/telegram_listener.err.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# NUR der Zustandspfad ist beschreibbar. Dass der Release-Baum es nicht
# ist, gehoert zum Beweis: unveraenderlich heisst auch fuer den Dienst.
ReadWritePaths=/home/kai/ai_analyst_trading_bot

[Install]
WantedBy=multi-user.target
