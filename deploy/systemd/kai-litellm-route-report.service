[Unit]
Description=KAI LiteLLM-Routenbericht — Beleglage je Route fuer das Kontrollcenter (nur lesend)
After=kai-server.service
OnFailure=kai-unit-failure-notify@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/kai/ai_analyst_trading_bot
Environment=PYTHONIOENCODING=utf-8
# Offline: liest Telemetrie und Transport-Log, schreibt JSON + Markdown atomar nach
# artifacts/. Kein Modellaufruf, kein Netz, keine Freigabe (LiteLLM-Audit, Nachtrag 30.09.).
ExecStart=/home/kai/ai_analyst_trading_bot/.venv/bin/python -m scripts.litellm_route_report.cli --telemetry artifacts/llm_telemetry.jsonl --transport-log logs/litellm.err.log --json-out artifacts/litellm_route_report.json --md-out artifacts/litellm_route_report.md
TimeoutStartSec=300
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
