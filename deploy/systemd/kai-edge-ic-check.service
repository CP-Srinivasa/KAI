[Unit]
Description=KAI Edge-IC one-shot notify (generator-edge n + IC -> Telegram)
After=network-online.target
Wants=network-online.target
OnFailure=kai-unit-failure-notify@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai_analyst_trading_bot
EnvironmentFile=/home/ubuntu/ai_analyst_trading_bot/.env
ExecStart=/home/ubuntu/ai_analyst_trading_bot/.venv/bin/python /home/ubuntu/edge_ic_notify.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=180
