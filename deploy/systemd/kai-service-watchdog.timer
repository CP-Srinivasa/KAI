[Unit]
Description=KAI Pi External Service Watchdog — every 5 minutes

[Timer]
# OnActiveSec statt OnBootSec: verankert sich am TIMER, nicht am Boot, und
# ueberlebt damit jeden Restart. Contract: tests/unit/test_timer_recurring_contract.py
OnActiveSec=2min
OnUnitActiveSec=5min
Unit=kai-service-watchdog.service

[Install]
WantedBy=timers.target
