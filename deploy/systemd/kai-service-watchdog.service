[Unit]
Description=KAI Pi External Service Watchdog
After=network-online.target
Wants=network-online.target
OnFailure=kai-unit-failure-notify@%n.service

[Service]
Type=oneshot
# Ohne `User=` lief diese Unit als ROOT — und fuehrte dabei ein Skript aus, das
# dem unprivilegierten Service-User gehoert und von ihm beschreibbar ist
# (`-rw-rw-r-- ubuntu ubuntu scripts/pi_service_watchdog.sh`, Audit 09.08.).
# Alle 57 uebrigen Units laufen als `ubuntu`; wer diesen User kompromittiert,
# haette den Skriptinhalt getauscht und beim naechsten Watchdog-Tick root
# ausgefuehrt. Die Unit haelt sich jetzt punktuell per NOPASSWD-sudo (nur
# `systemctl start`, siehe systemctl_start() im Skript), statt durchgehend
# privilegiert zu laufen. Alle uebrigen Aufrufe (is-active, list-units) sind
# lesend und brauchen ohnehin keine Rechte.
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai_analyst_trading_bot
EnvironmentFile=/home/ubuntu/ai_analyst_trading_bot/.env
Environment=PYTHONIOENCODING=utf-8
ExecStart=/bin/bash /home/ubuntu/ai_analyst_trading_bot/scripts/pi_service_watchdog.sh
StandardOutput=journal
StandardError=journal
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/ai_analyst_trading_bot
