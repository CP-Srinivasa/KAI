[Unit]
Description=KAI Liquidation Stream — Binance all-market !forceOrder@arr canary (read-only, #316)
After=network-online.target
Wants=network-online.target
OnFailure=kai-unit-failure-notify@%n.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# Der Code liegt im unveraenderlichen Release; `current` wird vom Wrapper
# beim Start AUFGELOEST und der aufgeloeste Pfad im Marker gefuehrt — ein
# spaeter umgeschaltetes current etikettiert diesen Prozess nicht um.
WorkingDirectory=/home/kai/current
# Kein __pycache__ im versiegelten Baum — sonst versuchte der Interpreter,
# genau das zu beschreiben, was unveraenderlich sein soll.
Environment=PYTHONDONTWRITEBYTECODE=1
# KEIN PYTHONPATH: der Import-Root ist der aufgeloeste Release-Baum, in den
# der Wrapper vor dem execv wechselt. Ein statischer Pfad hier zeigte in den
# beweglichen Checkout und haette die Release-Bindung wieder aufgehoben —
# der Marker haette das Release bezeugt und der Prozess anderen Code geladen.
EnvironmentFile=/home/kai/ai_analyst_trading_bot/.env

# Read-only canary: consumes the FREE public Binance USDT-M futures liquidation
# stream (wss://fstream.binance.com/ws/!forceOrder@arr, no key) and appends
# normalized LiquidationEvents to artifacts/liquidation_events.jsonl plus a
# heartbeat. NO trading, NO gates, NO capital path. The consumer reconnects with
# exponential backoff on its own; Restart=always is the systemd backstop for a
# hard process exit.
# Selbst-Attestierung: dieser Prozess ermittelt seine Revision, schreibt den
# Marker unter der EIGENEN PID und wird dann per os.execv zum Dienst. execv
# behaelt PID und Kernel-Startzeit, also sind Marker und Dienst dieselbe
# Identitaet. ExecStartPost koennte das nicht: ein zweiter Prozess wuerde
# einen selbst gelesenen Commit einer fremden MainPID zuschreiben.
ExecStart=/home/kai/current/.venv/bin/python -m app.cli.main trading runtime-exec --unit %n --repo /home/kai/current -- /home/kai/current/.venv/bin/python -m app.ingestion.liquidations.binance_stream

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Light: a single WebSocket connection + small JSONL appends. Conservative caps.
MemoryMax=192M
CPUQuota=40%

[Install]
WantedBy=multi-user.target
