[Unit]
Description=KAI Agent Worker (SENTR/Watchdog/Architect/DALI/Neo/SATOSHI)
After=kai-server.service
Requires=kai-server.service
OnFailure=kai-unit-failure-notify@%n.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/kai/ai_analyst_trading_bot
EnvironmentFile=/home/kai/ai_analyst_trading_bot/.env
Environment=PYTHONIOENCODING=utf-8
# D-208: ensure logs/ exists and is owned by service-user before systemd
# opens StandardOutput=append: as root.
ExecStartPre=+/bin/bash -c 'mkdir -p /home/kai/ai_analyst_trading_bot/logs && chown -R ubuntu:ubuntu /home/kai/ai_analyst_trading_bot/logs'
ExecStart=/home/kai/ai_analyst_trading_bot/.venv/bin/python -m app.agents.worker --loop
# Der Dienst bezeugt beim Start, welchen Commit er geladen hat.
# ExecStartPost, NICHT ExecStartPre: dort gibt es die MainPID noch nicht,
# und ein Marker mit fremder PID saehe wie ein Beweis aus, ohne einer zu sein.
# Schlaegt es fehl, bleibt der Zustand UNKNOWN — deshalb mit '-' nicht fatal.
ExecStartPost=-/home/kai/ai_analyst_trading_bot/.venv/bin/python -m app.cli.main trading runtime-marker-write --unit %n --repo /home/kai/ai_analyst_trading_bot
Restart=always
RestartSec=30
StandardOutput=append:/home/kai/ai_analyst_trading_bot/logs/agent_worker.log
StandardError=append:/home/kai/ai_analyst_trading_bot/logs/agent_worker.err.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/kai/ai_analyst_trading_bot

[Install]
WantedBy=multi-user.target
