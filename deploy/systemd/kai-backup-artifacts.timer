[Unit]
Description=Trigger KAI Artifact Backup taeglich

[Timer]
# Taeglich 03:40 lokal — nach den naechtlichen Feeds/Refreshs, vor dem
# Operator-Digest, damit die unersetzbare Wahrheits-Schicht vorher gesichert ist.
# Backup ist read-/append-only (Archiv + Audit/Log), nie Quelldaten-Mutation.
OnCalendar=*-*-* 03:40:00
Persistent=true
AccuracySec=120s
Unit=kai-backup-artifacts.service

[Install]
WantedBy=timers.target
