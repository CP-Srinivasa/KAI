[Unit]
Description=KAI CORE8 Forecaster Panel — resolve due shadow questions (idempotent, fail-closed)
After=network-online.target
Wants=network-online.target
OnFailure=kai-unit-failure-notify@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai_analyst_trading_bot
Environment=PYTHONPATH=/home/ubuntu/ai_analyst_trading_bot
EnvironmentFile=/home/ubuntu/ai_analyst_trading_bot/.env

# Resolves every ISSUED question whose outcome window is complete, against the
# RECORDED sealed medians/baselines (never recomputed). Idempotent: already
# resolved (panel_index, question_id) pairs are skipped. A provider failure
# leaves the affected panel pending (fail-closed) instead of minting false
# data-gap invalidations.
ExecStart=/home/ubuntu/ai_analyst_trading_bot/.venv/bin/python -m app.cli.main trading forecaster-resolve

StandardOutput=journal
StandardError=journal
TimeoutStartSec=300

MemoryMax=256M
CPUQuota=50%
