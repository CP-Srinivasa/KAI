[Unit]
Description=KAI OKX-Announcements — poll every 30 min
# Kein Requires= auf Timern (Kaskaden-Lehre #414, kai_timer_requires_cascade_20260624):
# ein Stop/Fehler der .service darf den Timer nicht bis zum Reboot stranden.

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
Persistent=true
AccuracySec=1min
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
