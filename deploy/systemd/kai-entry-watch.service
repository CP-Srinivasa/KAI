[Unit]
Description=KAI high-frequency operator entry watcher
After=kai-server.service
Requires=kai-server.service
# Härtung 2026-05-14: Tolerate brief config-validation-loops post-deploy.
# Pre-2026-05-14 default (5 starts in 10s) trips after a single mid-deploy
# .env / runtime-config inconsistency (siehe entry-watch crash counter 1091
# am 2026-05-12 12:10-12:11 — pydantic-ValidationError max_open_positions=10
# vs. CONFIG_SCHEMA.json maximum=3). 10 Starts in 5 min lässt Restart=always
# transiente Drifts überstehen, statt den Service permanent zu killen.
StartLimitIntervalSec=300
StartLimitBurst=10
OnFailure=kai-unit-failure-notify@%n.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# Der Code liegt im unveraenderlichen Release; `current` wird vom Wrapper
# beim Start AUFGELOEST und der aufgeloeste Pfad im Marker gefuehrt — ein
# spaeter umgeschaltetes current etikettiert diesen Prozess nicht um.
WorkingDirectory=/home/kai/current
# Kein __pycache__ im versiegelten Baum — sonst versuchte der Interpreter,
# genau das zu beschreiben, was unveraenderlich sein soll.
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/home/kai/ai_analyst_trading_bot/.env
Environment=PYTHONIOENCODING=utf-8
# Selbst-Attestierung: dieser Prozess ermittelt seine Revision, schreibt den
# Marker unter der EIGENEN PID und wird dann per os.execv zum Dienst. execv
# behaelt PID und Kernel-Startzeit, also sind Marker und Dienst dieselbe
# Identitaet. ExecStartPost koennte das nicht: ein zweiter Prozess wuerde
# einen selbst gelesenen Commit einer fremden MainPID zuschreiben.
ExecStart=/home/kai/current/.venv/bin/python -m app.cli.main trading runtime-exec --unit %n --repo /home/kai/current -- /home/kai/current/.venv/bin/python -m app.cli.main trading operator-signal-entry-watch --duration-seconds 55 --poll-interval-seconds 5
Restart=always
RestartSec=5
# Audit 16.09. P1-10 (S-0917 C4): ohne Zeitgrenze bleibt ein Haenger in run_tick()
# unsichtbar — die Deadline des Watchers greift erst NACH dem await. Gemessen
# (Pi, 7 Tage bis 17.09., n=8 281 Laeufe): p50 63,7 s, p99 68,3 s, Maximum 81,1 s.
# 120 s liegt rund 50 % ueber dem Maximum; ein Abbruch endet als Fehlschlag und
# loest OnFailure aus — genau das Signal, das bisher fehlte.
RuntimeMaxSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
