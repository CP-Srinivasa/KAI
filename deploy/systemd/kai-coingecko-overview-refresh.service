[Unit]
Description=KAI CoinGecko-Overview-Refresh — warm the decoupled market-overview snapshot (Source-Intake G1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai_analyst_trading_bot
Environment=PYTHONPATH=/home/ubuntu/ai_analyst_trading_bot
EnvironmentFile=-/home/ubuntu/ai_analyst_trading_bot/.env
# Decoupled refresh: writes artifacts/coingecko_overview_cache.json + shadow log.
# Default-OFF via APP_COINGECKO_OVERVIEW_ENABLED (no-op until the operator opts in).
# "-" prefix: a failed refresh must never propagate (loop never reads this yet).
ExecStart=-/home/ubuntu/ai_analyst_trading_bot/.venv/bin/python /home/ubuntu/ai_analyst_trading_bot/scripts/coingecko_overview_refresh.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=180
MemoryMax=128M
CPUQuota=50%
