[Unit]
Description=KAI TradingView Auto-Promote — accepted webhook events → technical-path candidates (WP-C, gated)
OnFailure=kai-unit-failure-notify@%n.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/ai_analyst_trading_bot
EnvironmentFile=-/home/ubuntu/ai_analyst_trading_bot/.env
ExecStart=/home/ubuntu/ai_analyst_trading_bot/.venv/bin/trading-bot tradingview auto-promote
