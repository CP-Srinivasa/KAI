[Unit]
Description=KAI Paper-Trading cron tick (10-min functional parity with Windows Task Scheduler)
After=kai-server.service
# Wants=, NICHT Requires=: ``Requires=`` propagiert den Stop. Jeder Neustart von
# kai-server erschlaegt damit einen gerade LAUFENDEN Lauf per SIGTERM, die Unit
# endet als ``failed (result=signal)`` und der OnFailure-Notifier meldet einen
# Defekt, den es nicht gibt (07.-21.08.2026: 9 solcher Meldungen, 6 davon
# kai-paper-trading — mitten in der Order-Buchung abgeschnitten).
# ``After=`` bleibt: die Startreihenfolge ist davon unberuehrt.
Wants=kai-server.service
OnFailure=kai-unit-failure-notify@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/kai/ai_analyst_trading_bot
EnvironmentFile=/home/kai/ai_analyst_trading_bot/.env
Environment=PYTHON=/home/kai/ai_analyst_trading_bot/.venv/bin/python
Environment=PYTHONIOENCODING=utf-8
# Operator-Entscheidung 2026-06-03: Canary auf `conservative` geflippt, um den
# Shadow-Messkanal zu entgiften (NEO-P-002-r2, Schritt 1). `entry_mode` bleibt
# davon unberuehrt und disabled.
#
# Der Wert stand bis 2026-09-09 nur in einem Drop-In unter
# `/etc/systemd/system/kai-paper-trading.service.d/canary.conf`, also NEBEN der
# Unit, die der Deploy-Abgleich vergleicht. Damit entschied eine Datei ueber das
# Verhalten, die in keinem Byte-Beweis vorkam -- und der Abgleich verweigerte zu
# Recht jede weitere Unit-Installation, solange sie dort lag. Hier steht sie
# jetzt kanonisch; das Drop-In wird als eigener Operator-Schritt entfernt,
# nachdem diese Zeile ausgerollt ist.
Environment=PAPER_CRON_PROFILE=conservative
ExecStart=/bin/bash /home/kai/ai_analyst_trading_bot/scripts/paper_trading_cron.sh
StandardOutput=journal
StandardError=journal
# Script writes its own structured log to artifacts/paper_trading_cron.log;
# systemd-journal captures anything that bleeds to stdout/stderr beyond that.
