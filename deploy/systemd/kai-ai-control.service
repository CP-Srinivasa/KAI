[Unit]
Description=KAI KI-Kontrollstation — Guthaben, Schalter-Protokoll, Telegram-Hinweise (nur lesend gegenueber KAI)
After=kai-server.service
OnFailure=kai-unit-failure-notify@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/kai/ai_analyst_trading_bot
Environment=PYTHONIOENCODING=utf-8
# Liest Telemetrie und Artefakte, fragt hoechstens stuendlich die Guthaben-APIs (DeepSeek,
# Kimi, optional OpenAI-Admin) und schreibt artifacts/ai_accounts.json sowie
# artifacts/runtime/ai_control_*.json. Kein Modellaufruf, keine Konfigurationsaenderung.
ExecStart=/home/kai/ai_analyst_trading_bot/.venv/bin/python -m app.observability.ai_control.tick
TimeoutStartSec=120
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
