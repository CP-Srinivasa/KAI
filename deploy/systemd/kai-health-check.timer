[Unit]
Description=KAI System Health Check — fire every 15 minutes
# Kein Requires= auf Timern (Kaskaden-Lehre #414, kai_timer_requires_cascade_20260624):
# ein Stop/Fehler der .service darf den Timer nicht bis zum Reboot stranden.

[Timer]
# Every 15 minutes (matches cooldown floor of 30min so we get 2 attempts per cooldown).
OnCalendar=*-*-* *:00/15:00
Persistent=true
AccuracySec=60s
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
