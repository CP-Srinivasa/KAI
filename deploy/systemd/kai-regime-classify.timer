[Unit]
Description=KAI Regime Classifier — hourly trigger
# Kein Requires= auf Timern (Kaskaden-Lehre #414, kai_timer_requires_cascade_20260624):
# ein Stop/Fehler der .service darf den Timer nicht bis zum Reboot stranden.

[Timer]
# Fire 5 minutes past every hour, after most exchanges have closed their candle.
OnCalendar=*-*-* *:05:00
# If the system was off when the timer should have fired, run it on the next boot.
Persistent=true
# Avoid pile-ups on slow Pi cycles.
AccuracySec=60s
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
