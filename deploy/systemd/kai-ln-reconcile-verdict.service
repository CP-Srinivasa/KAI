[Unit]
Description=KAI pull the sealed reconciliation shadow pre-registration verdict (read-only)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/kai/ai_analyst_trading_bot
Environment=PYTHONPATH=/home/kai/ai_analyst_trading_bot
Environment=PYTHONIOENCODING=utf-8
EnvironmentFile=-/home/kai/ai_analyst_trading_bot/.env
# Schreibt die Chronik NUR bei Verdikt-Wechsel. Alarmiert und faerbt rot bei
# FAIL sowie bei INCONCLUSIVE_BY_TIMEOUT (Fenster abgelaufen, n nicht erreicht).
# IMMATURE ist bis zur Reife der Normalzustand und darf weder alarmieren noch
# als Stoerung erscheinen — ein verstrichener Stichtag dagegen verlangt eine
# Entscheidung und bleibt sichtbar rot, bis der Operator die Resolution setzt.
# (--alert-on-fail deckt beide Zustaende ab; der Flag-Name bleibt aus
# Kompatibilitaet mit der installierten Unit unveraendert.)
ExecStart=/home/kai/ai_analyst_trading_bot/.venv/bin/python \
    /home/kai/ai_analyst_trading_bot/scripts/ln_reconciliation_eval.py \
    --json \
    --record /home/kai/ai_analyst_trading_bot/artifacts/research/ln_reconciliation_verdict.jsonl \
    --alert-on-fail \
    --exit-nonzero-on-fail
StandardOutput=journal
StandardError=journal
TimeoutStartSec=2min
MemoryMax=192M
CPUQuota=25%
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
