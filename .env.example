# Isolated, default-off, grey-area research layer. NOT part of the production
# pipeline. Run with: python -m app.exploration.cli run
# ───────────────────────────────────────────────────────────────────────────
EXPLORATION_ENABLED=false
EXPLORATION_TIMEOUT_SECONDS=20
EXPLORATION_MAX_RECORDS_PER_PROBE=50
EXPLORATION_MIN_REQUEST_INTERVAL_SECONDS=2.0
EXPLORATION_ARTIFACTS_DIR=artifacts/exploration
EXPLORATION_SAMPLE_SYMBOL=BTC
EXPLORATION_SAMPLE_SYMBOLS=BTC,ETH,SOL
EXPLORATION_SNAPSHOTS_ENABLED=false
EXPLORATION_SNAPSHOT_TA_ENABLED=true
EXPLORATION_SCRAPE_BROWSER_UA_ENABLED=false

EXPLORATION_COINGECKO_ENABLED=false
EXPLORATION_COINGECKO_SCRAPE_ENABLED=false
EXPLORATION_COINGLASS_ENABLED=false
EXPLORATION_COINGLASS_SCRAPE_ENABLED=false
EXPLORATION_MESSARI_ENABLED=false
EXPLORATION_MESSARI_SCRAPE_ENABLED=false
EXPLORATION_DUNE_ENABLED=false
EXPLORATION_GLASSNODE_ENABLED=false
EXPLORATION_GLASSNODE_SCRAPE_ENABLED=false
EXPLORATION_COINMARKETCAP_ENABLED=false
EXPLORATION_COINMARKETCAP_SCRAPE_ENABLED=false
EXPLORATION_NANSEN_ENABLED=false
EXPLORATION_NANSEN_SCRAPE_ENABLED=false

# Dune query id is NUMERIC (the number in dune.com/queries/<NNNN>/...), NOT your
# username. Empty/non-numeric -> probe falls back to a public sample query.
# EXPLORATION_DUNE_QUERY_ID=4132129

EXPLORATION_COINGECKO_API_KEY=
EXPLORATION_COINGLASS_API_KEY=
EXPLORATION_MESSARI_API_KEY=
EXPLORATION_DUNE_API_KEY=
EXPLORATION_GLASSNODE_API_KEY=
EXPLORATION_COINMARKETCAP_API_KEY=
EXPLORATION_NANSEN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Sovereign Bitcoin chain integration (L1 Fee-Truth, #313) — default-off
# ─────────────────────────────────────────────────────────────────────────────
# Read-only + fail-closed: KAI reads on-chain truth (tip height, sync state, fee
# estimates, mempool) from its OWN bitcoind over WireGuard, not third-party APIs.
# When disabled or unreachable the trading loop is unaffected (graceful degrade)
# and /dashboard/api/chain reports state=disabled|unavailable instead of ok.
# Code is complete + tested; activation is purely external (bitcoind RPC must be
# reachable). Set APP_CHAIN_ENABLED=true and provide EITHER user+password OR a
# cookie file path; on next app boot the fee-shadow scheduler self-activates and
# appends to artifacts/onchain_fee_shadow.jsonl.
APP_CHAIN_ENABLED=false
APP_CHAIN_HOST=10.27.0.51
APP_CHAIN_RPC_PORT=8332
APP_CHAIN_RPC_USER=
APP_CHAIN_RPC_PASSWORD=
# Alternative to user/password — bitcoind cookie file (leave creds empty if used):
APP_CHAIN_COOKIE_PATH=
APP_CHAIN_TIMEOUT_SECONDS=8.0
APP_CHAIN_FEE_SHADOW_INTERVAL_SECONDS=900

# --- Auth / Zugang (Audit 2026-08-09) --------------------------------------
# Diese Schluessel fehlten hier vollstaendig. Ein aus dieser Vorlage
# provisionierter Host startete deshalb mit LEERER Dashboard-Allowlist —
# und die Guard-Bedingung in app/security/auth.py behandelt eine leere
# Allowlist wie "niemand ist eingetragen, also pruefe nicht". Wer die Datei
# als Referenz nimmt, muss sehen, dass es sie gibt.

# Komma-separierte E-Mail-Allowlist fuer /dashboard/* hinter Cloudflare Access.
# LEER LASSEN heisst NICHT "offen fuer alle" — es heisst "unkonfiguriert".
CF_ACCESS_ALLOWED_EMAILS=

# Zweiter, waehrend eines Rotationsfensters zusaetzlich akzeptierter Bearer
# (SENTR-F-008). Ablauf: next setzen -> Clients umstellen -> next nach api_key
# ziehen -> next leeren. Leer = keine Rotation aktiv.
APP_API_KEY_NEXT=

# HMAC-Geheimnis der TradingView-Webhooks. Ohne ihn ist der Ingress-Endpunkt
# nicht signaturgeprueft.
TRADINGVIEW_WEBHOOK_SECRET=

# Shared-Token-Fallback fuer TradingViews nativen Webhook, der keinen Body-HMAC
# erzeugen kann. Wird nur in den Modi shared_token / hmac_or_token /
# hmac_strict_event_id gelesen (TRADINGVIEW_WEBHOOK_AUTH_MODE, Default hmac)
# und ist dort Pflicht. Leer = kein Token; Kill-Switch:
# TRADINGVIEW_WEBHOOK_SHARED_TOKEN_DISABLED=true.
TRADINGVIEW_WEBHOOK_SHARED_TOKEN=

# Nur setzen, wenn der Server bewusst an eine Nicht-Loopback-Adresse binden
# soll. Default fail-closed: Bind an 0.0.0.0 wird ohne dieses Flag abgelehnt.
APP_ALLOW_NON_LOOPBACK_BIND=false

# Adresse, an die uvicorn bindet (scripts/server_start.sh liest sie zuerst).
# Nicht-Loopback (0.0.0.0, ::, *) wird in Produktion nur zusammen mit
# APP_ALLOW_NON_LOOPBACK_BIND=true akzeptiert. Alias: API_BIND_HOST.
APP_API_BIND_HOST=127.0.0.1

# --- Security-Header (SENTR-F-007) ------------------------------------------
#
# Tiefenverteidigung fuer Direktpfade, auf denen die Cloudflare-Kante kein TLS
# terminiert und keine Header setzt. Abschalten nur, wenn ein vorgelagerter
# Reverse-Proxy dieselben Header injiziert.
APP_SECURITY_HEADERS_ENABLED=true
# HSTS max-age in Sekunden; 0 = Header aus. Default ein Jahr.
APP_SECURITY_HEADERS_HSTS_MAX_AGE=31536000
# true = CSP als Content-Security-Policy-Report-Only (sicherer Rollout),
# false = erzwingen.
APP_SECURITY_HEADERS_CSP_REPORT_ONLY=false
# Zusaetzliche script-src-Origins (durch Leerzeichen getrennt) neben 'self'.
APP_SECURITY_HEADERS_EXTRA_CSP_SCRIPT_SRC=
# true = CSP erlaubt das eingebettete TradingView-Chart-Widget
# (*.tradingview.com plus dessen Inline-Skripte); false fuer gehaertete
# Deployments ohne Widget.
APP_SECURITY_HEADERS_ALLOW_TRADINGVIEW=true

# --- Auth-Brute-Force-Schutz (SENTR-F-003) ----------------------------------
#
# Gleitendes Fenster je Client-IP im Speicher: ab THRESHOLD Fehlversuchen im
# Fenster antwortet jeder weitere Versuch mit 429 + Retry-After, bis der
# aelteste Fehlversuch herausfaellt. THRESHOLD=0 schaltet den Schutz ab (nur
# fuer Integrations-Smokes gedacht, die /dashboard/* absichtlich haemmern).
APP_AUTH_RATE_LIMIT_THRESHOLD=5
APP_AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Exchange-Adapter (app/core/settings.py::ExchangeSettings) --------------
#
# Live-Execution ist AUS (Paper-/Approval-Mode); die Adapter-Defaults sind
# fail-safe: dry_run und testnet an. Zugangsdaten nur hier, nie in Code oder
# Doku; leer = Adapter ohne Zugang.
EXCHANGE_DRY_RUN=true
EXCHANGE_TESTNET=true
# binance | bybit
EXCHANGE_DEFAULT_EXCHANGE=binance
# Erlaubte Symbole als JSON-Liste. Auskommentiert lassen, solange keine
# Freigabe gewollt ist -- ein LEERER Wert waere fuer eine Liste ungueltig.
# EXCHANGE_WHITELIST=["BTC/USDT","ETH/USDT"]
EXCHANGE_BINANCE_API_KEY=
EXCHANGE_BINANCE_SECRET=
EXCHANGE_BYBIT_API_KEY=
EXCHANGE_BYBIT_SECRET=
# spot | linear | inverse
EXCHANGE_BYBIT_CATEGORY=spot
EXCHANGE_TIMEOUT_SECONDS=15

# --- LiteLLM-Transport (ADR 0019) ------------------------------------------
#
# Der Transport laeuft als eigener, versiegelter Baum neben `releases/`, nicht
# im Release-venv: `litellm[proxy]` verlangt `openai<3.0.0`, der Kern faehrt
# `openai==3.6.0`. Gebaut wird er mit `scripts/pi_make_transport.sh`, gestartet
# ueber `scripts/pi_transport_exec.sh`, das den Baum vorher attestiert.
#
# OHNE die folgenden Werte startet LiteLLM NICHT. `config/litellm.yaml` loest
# jeden Eintrag ueber `os.environ/<NAME>` auf; fehlt einer, bricht der Proxy
# beim Start ab, bevor er einen Port oeffnet. Das ist kein Fehler der Unit --
# es ist eine unvollstaendige Konfiguration, die genauso aussieht.

# Ein EIGENES, neues, starkes Geheimnis -- niemals aus einem Provider-Key
# abgeleitet: sonst haette ein Leck des einen sofort den anderen mit. Selbst
# erzeugen, z. B. `openssl rand -hex 32`. Der Proxy hoert ausschliesslich auf
# 127.0.0.1; der Schluessel schuetzt ihn gegen alles, was lokal danebenlaeuft.
# Nicht committen.
LITELLM_MASTER_KEY=

# Die fuenf logischen Routen aus `app/ai/config.py::route_aliases`. Die Namen
# links sind KAIs Vokabular, die Werte rechts LiteLLM-Modellstrings der Form
# `<provider>/<modell>`. KAI entscheidet die Route, der Transport das Backend
# dahinter -- deshalb stehen die Modelle hier und nicht im Code.
#
# OPERATOR-ENTSCHEIDUNG 2026-09-08 fuer den ERSTEN echten SHADOW-Lauf: alle
# vier Textrouten auf denselben Provider, ohne Anthropic (dessen Auto-Aufladung
# ist abgeschaltet, und KAI darf von dortigem Guthaben nicht abhaengen):
#
#   KAI_LITELLM_BULK_MODEL=gemini/gemini-2.5-flash
#   KAI_LITELLM_STANDARD_MODEL=gemini/gemini-2.5-flash
#   KAI_LITELLM_REASONING_MODEL=gemini/gemini-2.5-flash
#   KAI_LITELLM_CRITICAL_MODEL=gemini/gemini-2.5-flash
#   KAI_LITELLM_STT_MODEL=openai/whisper-1
#   KAI_LITELLM_DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
#
# Der Grund ist Diagnostik, nicht Sparsamkeit: der erste Lauf beantwortet die
# Frage "traegt die Kette Transport -> Proxy -> Provider -> Antwort ->
# Telemetrie?". Scheitert dabei etwas, soll es EINE Modellroute und EINEN
# Provider geben, nicht drei. Ein staerkeres Modell auf Reasoning/Critical
# kostet an dieser Stelle Geld und beweist nichts, was Flash nicht auch
# beweist; der Vergleich lohnt erst, wenn eine Grundlinie existiert.
#
# Die Werte stehen bewusst als Kommentar und nicht als Vorgabe: die Routen sind
# Operator-Konfiguration und gehoeren in die `.env` des Zielsystems, nicht in
# die Vorlage. Im SHADOW aendern sie nichts am Primaerpfad -- genau dafuer ist
# der Schattenlauf da.
KAI_LITELLM_BULK_MODEL=
KAI_LITELLM_STANDARD_MODEL=
KAI_LITELLM_REASONING_MODEL=
KAI_LITELLM_CRITICAL_MODEL=
KAI_LITELLM_STT_MODEL=
KAI_LITELLM_DEEPSEEK_MODEL=

# --- Entwicklerreserve (ADR 0020, D-CORE-009) -------------------------------
#
# ZWEITER LiteLLM-Proxy (`config/litellm_dev.yaml`, 127.0.0.1:4001) fuer einen
# Entwicklerclient (OpenCode, optional Codex-Profil) -- NICHT fuer KAI. `app/ai`
# kennt diese Variablen nicht, die Laufzeit-Fallback-Kette auch nicht. Kein
# Wert hier schaltet irgendetwas in KAI ein; ohne alle sieben startet
# `scripts/dev_reserve.sh proxy` gar nicht (fail-closed).
#
# Eigener Proxy-Schluessel. Der Laufzeit-`LITELLM_MASTER_KEY` bleibt auf der
# Pi; dieser hier ist der EINZIGE Wert, der den Laptop erreicht (dort als
# `KAI_DEV_LITELLM_KEY` fuer OpenCode). Nicht committen.
LITELLM_DEV_MASTER_KEY=
# Modell je Rolle, LiteLLM-Schreibweise `<provider>/<modell>`. Beispiel
# (Stand 2026-09-14, gegen die Anbieterliste pruefen, bevor es gesetzt wird):
#   KAI_DEV_LITELLM_ECONOMY_MODEL=deepseek/deepseek-flash      (V4.1 Flash)
#   KAI_DEV_LITELLM_CODE_MODEL=moonshot/kimi-k2.7-code
#   KAI_DEV_LITELLM_FRONTIER_MODEL=moonshot/kimi-k3            (nur nach Freigabe)
KAI_DEV_LITELLM_ECONOMY_MODEL=
KAI_DEV_LITELLM_CODE_MODEL=
KAI_DEV_LITELLM_FRONTIER_MODEL=
# EIGENE Entwickler-Schluessel beim Anbieter, nicht MOONSHOT_API_KEY /
# DEEPSEEK_API_KEY der Laufzeit: Verbrauch bleibt beim Anbieter getrennt
# sichtbar, und der Reserve-Proxy braucht keinen Produktionsschluessel.
# Budgetgrenzen dort am Schluessel setzen -- der Proxy ohne Datenbank kann
# keine durchsetzen.
KAI_DEV_LITELLM_ECONOMY_API_KEY=
KAI_DEV_LITELLM_CODE_API_KEY=
KAI_DEV_LITELLM_FRONTIER_API_KEY=

# --- KI-Budget und Alert-Reserve (app/ai/budget.py, #954, D-272, D-273) ------
#
# Tages- und Monatslimit in USD. Grundlage sind Listenpreise, entdoppelt je
# physischem Aufruf (D-272). /health/ai rechnet den Monat hoch.
# APP_AI_BUDGET_DAILY_USD=1.25
# APP_AI_BUDGET_MONTHLY_USD=25.00
#
# Alert-Reserve. Ohne sie endet nach erschoepftem Budget JEDE Analyse im
# Regelpfad, der hoechstens Prioritaet 6 erreicht -- die Alert-Schwelle 7 dann
# nie (Kettentests 2026-09-14). Mit Reserve bekommen alert-faehige Dokumente
# (regelbasierte Vorabprioritaet >= APP_AI_BUDGET_ALERT_MIN_RULE_PRIORITY) noch
# eine LLM-Bewertung. Die Reserve wird vom Tageslimit ABGEZWEIGT, sie erhoeht
# es nicht: der Normaltopf endet dann bei Tageslimit minus Reserve.
# Beide Grenzen setzen -- USD fuer belegte Kosten, Aufrufzahl fuer COST_UNKNOWN.
# Leer heisst: keine Reserve, Verhalten wie vor #954.
# Startwerte D-273: 0.15 USD / 20 Aufrufe (~20 Analysen a 0,0075 USD).
# APP_AI_BUDGET_ALERT_RESERVE_USD=0.15
# APP_AI_BUDGET_ALERT_RESERVE_MAX_CALLS=20
# APP_AI_BUDGET_ALERT_MIN_RULE_PRIORITY=3

# --- AI-Control-Plane (app/ai, ADR 0017) -----------------------------------
#
# Die Route-Autoritaet liegt bei KAI, nicht beim Transport. Diese Werte
# entscheiden, OB und WIE WEIT der Transport ueberhaupt beteiligt wird.
#
# Defaults sind fail-closed: ohne Eintrag ist `enabled=false` und
# `mode_ceiling=off`, der Transport wird also gar nicht erst gefragt.
# `shadow` heisst: LiteLLM laeuft parallel mit, das Ergebnis des Primaerpfads
# bleibt unberuehrt. `advisory` darf nur freien Research-Text zurueckgeben und
# besitzt weder AnalysisResult-, Alert- noch Execution-Autoritaet. `primary`
# ist ein eigener, spaeterer Operator-Schritt und fuer Research technisch
# ausgeschlossen.
KAI_INFERENCE_ENABLED=false
KAI_INFERENCE_MODE_CEILING=off
KAI_INFERENCE_ROUTE_MODES={}
# Kimi-k2.6 wurde fuer lange Research-Antworten gemessen; andere Routen bleiben
# beim globalen 30-s-Timeout. Dieser Wert aktiviert keinen Aufruf.
KAI_INFERENCE_ROUTE_TIMEOUT_SECONDS={"research":180}

# Denkbudget je Route, als JSON-Objekt. LEER heisst: kein Parameter, also
# unveraendertes Verhalten des Modells.
#
# Der teuerste Posten eines Aufrufs ist bei denkenden Modellen nicht die
# Antwort, sondern der Weg dorthin. Am 2026-09-08 auf kai-pi5 gemessen,
# `gemini/gemini-2.5-flash`, derselbe Prompt:
#
#   ohne Parameter   381 Denk-Token,  15 Text-Token, 0,0009957 USD, 3632 ms
#   Budget 128       104 Denk-Token,  45 Text-Token, 0,0003782 USD, 2354 ms
#   Budget 0           0 Denk-Token,  42 Text-Token, 0,0001107 USD,  772 ms
#
# Faktor 9 im Preis, Faktor 5 in der Zeit -- und die Antwort wurde LAENGER,
# nicht kuerzer. Ob sie besser war, sagt die Messung nicht. Genau deshalb steht
# hier ein Regler und keine Vorgabe: Qualitaet und Kosten sollen getrennt
# beobachtbar bleiben.
#
# `0` ist gueltig. Eine Route ohne Eintrag bleibt, wie sie ist. Eine Angabe im
# Aufruf selbst hat Vorrang.
#
# ACHTUNG -- fuer `gemini/gemini-3.6-flash` gilt das OBEN GESAGTE NICHT MEHR.
# Am 2026-09-09 auf kai-pi5 ueber den laufenden Proxy nachgemessen:
#
#   ohne Parameter                876 Denk-Token, 8353 ms
#   Budget 0   (dieser Regler)    867 Denk-Token, 6526 ms  <- WIRKUNGSLOS
#   reasoning_effort="low"        499 Denk-Token, 6366 ms
#   reasoning_effort="minimal"      0 Denk-Token, 1301 ms
#
# Der Grund ist die Form, nicht die Zahl: `thinking.budget_tokens` ist die
# Anthropic-Schreibweise, und LiteLLM 1.99.0 uebersetzt sie FUER DIESES MODELL
# nicht. Modellbezogen, nicht "fuer Gemini": auf `gemini-2.5-flash` hat derselbe
# Proxy am 2026-09-08 abgestuft geantwortet (Budget 128 -> 104 Denk-Token,
# Budget 0 -> 0). Der Token-Regler bleibt dort der wirksame Hebel.
# Belegt ist der 3.6-Befund am Statuscode, nicht am Token-Zaehler: derselbe Wert `0` gibt
# DIREKT gegen Google HTTP 400 ("invalid argument" -- gemini-3.6-flash kann
# Denken gar nicht abschalten), ueber LiteLLM aber 200 mit unveraendertem
# Denkaufwand. Ein Parameter, der eine Ablehnung ausloesen MUESSTE und keine
# ausloest, ist nie angekommen.
#
# Fuer Gemini ist deshalb KAI_INFERENCE_ROUTE_REASONING_EFFORT der Weg.
# dict-Feld: {} heisst "kein Regler"; ein leerer Wert waere ungueltig (JSON).
KAI_INFERENCE_ROUTE_REASONING_BUDGET={}

# Denkstufe je Route, als JSON-Objekt. LEER heisst: kein Parameter.
#
# Zweiter Regler und kein Ersatz: es sind zwei Dialekte, nicht zwei Meinungen
# ueber dieselbe Zahl. Ein Token-Budget ist nachpruefbar, eine Stufe ist ein
# Versprechen des Anbieters -- eine Umrechnung waere geraten, denn `minimal`
# ist kein bestimmter Token-Wert.
#
# Erlaubt sind `minimal`, `low`, `medium`, `high`. Ein unbekannter Wert laesst
# den Server NICHT starten, statt still zu "kein Regler" zu werden.
#
# KEINE EMPFEHLUNG. Der Regler existiert, weil er auf 3.6-flash der einzige
# wirksame ist -- nicht, weil er benutzt werden soll.
#
# Eine erste Messung an einer Schlagzeile ergab Faktor 10,9 im Preis bei
# gleicher Ausgabelaenge. Gegen ECHTE Analyse-Eingaben gemessen (vier reale
# Dokumente aus dem Betrieb, SYSTEM_PROMPT_V1, je 16 Laeufe, max_tokens=4096)
# kehrt sich das um:
#
#   Variante   Schema gueltig   Denken   USD Mittel   ms Mittel
#   ohne          15/16            858    0,0059899        8020
#   low           13/16            152    0,0033471        5306
#   minimal       11/16              0    0,0028493        3705
#
# Monoton: weniger Denken -> haeufiger `bull_case` als OBJEKT statt String ->
# schlechtere Schemaquote. Der frueher gemessene Vorsprung von `minimal` war
# ein Artefakt eines zu kleinen `max_tokens`: die Vergleichsgruppe wurde
# abgeschnitten, nicht uebertroffen.
#
# Operator-Entscheidung 2026-09-09: Referenzzustand ist `max_tokens=4096` mit
# LEEREM Regler. `minimal` und `low` sind KEINE SHADOW-Kandidaten. Kosten
# werden erst nach der Schemaqualitaet optimiert, nie auf deren Kosten.
#
# Schreibweise, falls der Regler je gebraucht wird:
#   KAI_INFERENCE_ROUTE_REASONING_EFFORT={"bulk": "low"}
# dict-Feld: {} heisst "kein Regler"; ein leerer Wert waere ungueltig (JSON).
KAI_INFERENCE_ROUTE_REASONING_EFFORT={}
# Modell hinter der Research-Route. Der Alias `kai-kimi-research` ist fest,
# das Modell NICHT: hier steht, welcher Anbieter die Route traegt. Gemessen und
# vorgesehen ist `moonshot/kimi-k2.6`; jeder LiteLLM-faehige Wert ist zulaessig,
# ohne Codeaenderung. Leer heisst: die Route hat kein Modell und traegt nichts.
KAI_LITELLM_RESEARCH_MODEL=
# Zugangsdaten des Anbieters, den KAI_LITELLM_RESEARCH_MODEL benennt. Fuer
# Moonshot ist das MOONSHOT_API_KEY. Ein Schluessel allein erteilt keine
# Routen-Autoritaet und aktiviert nichts.
MOONSHOT_API_KEY=
