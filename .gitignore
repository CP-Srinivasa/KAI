# Runtime artifacts (generated by analyze-pending, shadow-run, abc-run, etc.)
artifacts/
.test_doc_ids

# Workshop scratch files — agents that dump temporary code into the repo root
# (e.g. ".tmp_parser.py", ".tmp_bridge.py") should never end up tracked.
.tmp_*

# Root-level JSON/JSONL runtime artifacts (not config — these are generated outputs)
artifact.json
pass_report.json
promotion_record.json
report.json
tuning_manifest.json
test_companion.jsonl
test_teacher.jsonl

# Temp development scripts (not production code)
tests/modify_main.py
tests/run_sprint14.ps1

# Tool caches (regenerable, no project value)
.mypy_cache/
.ruff_cache/
.hypothesis/

# Claude Code local config (session-specific, not project config).
# Ausnahme: .claude/agents/*.md sind KEINE Session-Config, sondern Projekt-
# Config -- CLAUDE.md § Agent Roster und app/api/routers/agents.py::_AGENTS
# verweisen darauf, und tests/unit/test_agents_roster_contract.py prueft die
# Deckungsgleichheit. Solange sie unversioniert waren, konnten SSOT und
# Definitionen unbemerkt auseinanderlaufen (2026-08-09: kai-finder in der SSOT
# ohne Definition, sentr mit Definition am falschen Ort, vier Agenten gar nicht
# registriert). Bewusst eng: nur *.md, nichts sonst.
#
# Dasselbe gilt fuer .claude/skills/**/*.md: CLAUDE.md §7 verweist auf
# daily-strategy-review, kai-finder.md auf source-expansion und
# architecture-red-team.md auf research-crosscheck. Ein Skill, den ein
# versionierter Agent referenziert, gehoert selbst in die Versionierung --
# sonst zeigt die Referenz ins Leere und niemand merkt es.
#
# Weiterhin ignoriert: settings.json, alles Nicht-*.md (Skripte, Assets,
# Caches). Wird ein Skill je ein Helfer-Skript brauchen, ist das eine bewusste
# Erweiterung dieser Liste, keine stille.
.claude/*
!.claude/agents/
.claude/agents/*
!.claude/agents/*.md
!.claude/skills/
.claude/skills/**
!.claude/skills/**/
!.claude/skills/**/*.md

# APIs directory — contains real secrets, never commit
APIs/

# data/ directory — dev database files
data/

# Runtime PID files
.server.pid
.agent_worker.pid
.tunnel.pid
.telegram_listener.pid

# Frontend build artifacts (regenerable)
web/tsconfig.tsbuildinfo
web/.dist-prev-deploy-*/
web/.dist-snapshots/

# Generated lern-recalc outputs (kai-recalc-cycle.timer überschreibt daily 04:00)
monitor/source_reliability.json
monitor/source_ranking.json
monitor/source_rotation_state.json
# Source-discovery runtime (scout writes proposals; scheduler writes runs).
# The candidate SEED (source_candidates_seed.json) IS tracked — it is curated input.
monitor/source_proposals.jsonl
monitor/source_discovery_runs.jsonl
monitor/source_probation_state.json
monitor/generator_edge_watch_state.json

# L3 audit-integrity anchor records (runtime output of kai-integrity-anchor.timer)
monitor/integrity/

# d227 outcome-report upload staging (transient)
d227_upload_tmp/

# E2E test database (root-level)
test_e2e.db

# Claude Code / MCP-Server project config (per-host absolute paths, not portable)
.mcp.json
